# Kalshi API credentials
# Get these from your Kalshi account dashboard
KALSHI_API_KEY_ID=your_key_id_here
KALSHI_PRIVATE_KEY_PATH=path/to/kalshi_private.pem

# Set to 'demo' for paper trading, 'prod' for real money
# NEVER set to 'prod' without explicit sign-off from David
KALSHI_ENV=demo

# Database path (relative to repo root)
DB_PATH=data/quant_lab.db
